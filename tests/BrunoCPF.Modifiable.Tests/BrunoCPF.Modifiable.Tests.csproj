<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-free test suite. Runs with `dotnet test` (no Unity, no Godot).
    Targets the shared library directly, so it validates the exact code both
    engines consume.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Underscores in test method names are intentional (Given_When_Then style).
         CA1861: inline expected-value arrays in assertions are clearer than static fields. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BrunoCPF.Modifiable.Core/BrunoCPF.Modifiable.Core.csproj" />
    <ProjectReference Include="../../src/BrunoCPF.Modifiable/BrunoCPF.Modifiable.csproj" />
  </ItemGroup>

</Project>
