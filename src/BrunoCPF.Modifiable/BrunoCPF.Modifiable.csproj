<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The reactive layer: ModifiableProperty and its read-only view, built on R3. Depends on
    BrunoCPF.Modifiable.Core (a package dependency once packed). Mirrors the BrunoCPF.Modifiable
    Unity assembly.
  -->

  <PropertyGroup>
    <RootNamespace>BrunoCPF.Modifiable</RootNamespace>
    <AssemblyName>BrunoCPF.Modifiable</AssemblyName>
    <PackageId>BrunoCPF.Modifiable</PackageId>
    <Description>Reactive, bounded, and modifiable properties for RPG-style stat systems.</Description>
    <PackageTags>rpg;jrpg;stats;modifiers;reactive;godot;unity</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/Runtime/BrunoCPF.Modifiable/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BrunoCPF.Modifiable.Core/BrunoCPF.Modifiable.Core.csproj" />
    <PackageReference Include="R3" Version="1.*" />
  </ItemGroup>

</Project>
